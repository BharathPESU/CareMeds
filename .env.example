# Application
NEXT_PUBLIC_APP_NAME="CareMeds"
APP_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Kolkata"

# Supabase Postgres (Mumbai ap-south-1)
# Runtime queries use transaction pooler (port 6543, prepared statements disabled)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Drizzle migrations use session pooler (port 5432)
DIRECT_DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Supabase Storage (server-side only, private bucket: resident-documents)
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# Custom Authentication & Encryption Secrets
SESSION_SECRET="REPLACE_WITH_64_HEX_CHAR_RANDOM_SECRET"
MFA_ENCRYPTION_KEY="REPLACE_WITH_64_HEX_CHAR_AES256_KEY"
SETUP_TOKEN="REPLACE_WITH_ONE_TIME_ADMIN_SETUP_TOKEN"

# Vercel Cron Authorization
CRON_SECRET="REPLACE_WITH_RANDOM_CRON_SECRET"

# Notifications (Email via Resend, SMS via Twilio)
RESEND_API_KEY="MY_RESEND_API_KEY"
RESEND_FROM_EMAIL="alerts@caremeds.example.com"
TWILIO_ACCOUNT_SID="MY_TWILIO_ACCOUNT_SID"
TWILIO_AUTH_TOKEN="MY_TWILIO_AUTH_TOKEN"
TWILIO_FROM_NUMBER="+910000000000"

# Care Assistant AI (server-side only, never receives resident data)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Error Monitoring (Sentry - never log resident names, health data, or passwords)
SENTRY_DSN=""

# Administrative & Staff Initial Credentials (loaded from environment, never hardcoded)
ADMIN_INITIAL_PASSWORD="[ADMIN_INITIAL_PASSWORD]"
ADMIN_MFA_TOTP_SECRET="[ADMIN_MFA_TOTP_SECRET]"
STAFF_INITIAL_PASSWORD="[STAFF_INITIAL_PASSWORD]"

# Care Assistant AI Gemini Round-Robin Keys
GEMINI_API_KEY1="[GEMINI_API_KEY1]"
GEMINI_API_KEY2="[GEMINI_API_KEY2]"
GEMINI_API_KEY3="[GEMINI_API_KEY3]"
GEMINI_API_KEY4="[GEMINI_API_KEY4]"
